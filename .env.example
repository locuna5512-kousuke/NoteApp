# 設定項目の見本。値は空のまま Git に含める。
# 開発版: このファイルをコピーして .env.local を作り、値を入れる (.env.local は Git に含めない)
# 公開版: 公開先の管理画面で AI_MODE=mock だけを設定する (キーとモデル名は設定しない)

# real = 本物の Gemini (開発用) / mock または空 = デモ (公開用)
AI_MODE=
# Gemini の APIキー (サーバー側だけが読む。開発版だけ)
GEMINI_API_KEY=
# 使うモデル名 (例は AI Studio のモデル一覧を見る。開発版だけ)
GEMINI_MODEL=
# 1日に Gemini を呼んでよい回数 (省略時 50)
DAILY_LIMIT=
# タイピング表示で1文字にかける時間 (ミリ秒、省略時 30)
TYPING_SPEED=
